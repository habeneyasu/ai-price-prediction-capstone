# ============================================
# AI Price Prediction Capstone - Environment Variables
# ============================================
# Copy this file to .env and fill in your API keys
# cp .env.example .env

# ============================================
# Required: OpenRouter API Key (for Part A)
# ============================================
# Get your free API key at: https://openrouter.ai
# Free tier includes credits for testing
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================
# Optional: Ollama Configuration (for local models)
# ============================================
# Only needed if you want to use local Ollama models
# Install Ollama: https://ollama.ai
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# ============================================
# Optional: HuggingFace Token (for dataset loading)
# ============================================
# Only needed if loading from private HuggingFace datasets
# Get token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# ============================================
# Model Configuration (Optional - has defaults)
# ============================================
# Provider: 'openrouter' or 'ollama'
MODEL_PROVIDER=openrouter

# Model name (OpenRouter examples):
# - openai/gpt-4o (best quality, higher cost)
# - openai/gpt-4o-mini (good quality, lower cost) ⭐ RECOMMENDED
# - anthropic/claude-3-haiku (fast, cheap)
# - meta-llama/llama-3.1-8b-instruct (open source, very cheap)
MODEL_NAME=openai/gpt-4o-mini

# Temperature: 0.0-2.0 (lower = more deterministic)
MODEL_TEMPERATURE=0.3

# Max tokens in response (keep low to save costs)
MODEL_MAX_TOKENS=50

# ============================================
# Evaluation Configuration (Optional)
# ============================================
# Maximum samples to evaluate (0 = all, set low to save costs)
EVAL_MAX_SAMPLES=20

# Number of parallel workers
EVAL_NUM_WORKERS=3

# Generate plots (true/false)
EVAL_GENERATE_PLOTS=true

# ============================================
# Logging (Optional)
# ============================================
LOG_LEVEL=INFO
